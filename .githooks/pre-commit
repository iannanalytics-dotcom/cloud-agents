#!/bin/sh
# Blocks a commit whose staged files hold a key, a private file or a real person's details (tools/repo_check.py).
PY=$(command -v python || command -v python3 || command -v py)
[ -n "$PY" ] || { echo "repo check: Python not found, so the commit is blocked"; exit 1; }
exec "$PY" tools/repo_check.py staged
